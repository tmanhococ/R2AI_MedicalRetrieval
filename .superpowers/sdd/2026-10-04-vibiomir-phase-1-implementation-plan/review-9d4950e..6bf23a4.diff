+class OnePassIterator:
+    """An iterator that can strictly be iterated only once."""
+
+    def __init__(self, items):
+        self.items = list(items)
+        self.iterated = False
+
+    def __iter__(self):
+        if self.iterated:
+            raise RuntimeError("OnePassIterator cannot be iterated more than once!")
+        self.iterated = True
