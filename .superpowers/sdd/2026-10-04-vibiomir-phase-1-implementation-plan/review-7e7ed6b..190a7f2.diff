+    trace = RetrievalTrace(
+        query_id=1,
+        candidate_doc_ids=frozenset(),
+        reranked_doc_ids=frozenset(),
+        final_doc_ids=frozenset(),
+        final_chunk_ids=(),
+    )
+
+    breakdown = build_error_breakdown(trace=trace, gold=gold, store=store)
