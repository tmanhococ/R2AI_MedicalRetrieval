+            scores,
+            state,
+            expected_profile_fingerprint="profile_B",
+            expected_dataset_fingerprint="dataset_X",
+        )
+
+    # Mismatched dataset fingerprint should be rejected
+    with pytest.raises(ValueError, match="(?i)dataset.*fingerprint.*mismatch"):
