+    """Run ViBioMIR resumable crawler and write coverage report."""
+    reg_path = Path(registry_path)
+    raw_path = Path(raw_root)
+
+    if not reg_path.exists():
+        raise FileNotFoundError(f"Registry DB not found: {reg_path}")
+
+    config = CrawlConfig(
