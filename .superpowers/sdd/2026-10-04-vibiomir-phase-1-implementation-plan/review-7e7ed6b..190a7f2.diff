+def create_scanned_blank_pdf() -> bytes:
+    """Create a blank PDF simulating a scanned document with no extractable text."""
+    doc = pymupdf.open()
+    doc.new_page()
+    pdf_bytes = doc.tobytes()
+    doc.close()
+    return pdf_bytes
